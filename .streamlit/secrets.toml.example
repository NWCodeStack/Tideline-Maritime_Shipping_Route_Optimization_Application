# Copy to .streamlit/secrets.toml (git-ignored) locally, or paste into
# Streamlit Community Cloud -> App settings -> Secrets. Everything here is OPTIONAL:
# without it the copilot runs in deterministic command mode.

# Enables natural-language intent extraction and conversational explanations in the copilot.
ANTHROPIC_API_KEY = "sk-ant-..."

# Optional model override (default: claude-opus-5-5).
# TIDELINE_LLM_MODEL = "claude-opus-5-5"
